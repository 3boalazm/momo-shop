{
  "buildCommand": "pnpm install && pnpm vite build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/**/*.ts": { "runtime": "@vercel/node@5.1.0" }
  },
  "rewrites": [
    { "source": "/((?!api/|@vite/|@react-refresh|@id/|@fs/|src/|node_modules/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
