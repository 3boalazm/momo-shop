# === Momo Collective — Environment Variables ===
NODE_ENV=production

# --- Server (self-hosted on the Oracle VM; nginx proxies to it) ---
HOST=127.0.0.1
PORT=3000
# Where the built SPA lives. Defaults to <dist>/public next to the bundle.
STATIC_DIR=

# --- Database (Aiven-managed Postgres — see infra/aiven/README.md) ---
# From Aiven console > your service > Overview > Connection information,
# after running infra/aiven/setup-databases.sh to create this app's role+db.
DATABASE_URL=postgresql://oltre_app:password@<host>.aivencloud.com:<port>/oltre_shop
# Aiven refuses plaintext connections — "require" encrypts without checking
# the cert chain (default). Use "verify-full" + DATABASE_CA to also verify it.
# If you self-host Postgres on this same VM instead (infra/oracle-vm/setup-postgres.sh),
# use "disable" — loopback has nothing to encrypt against.
DATABASE_SSL=require
# PEM of the server CA — only read when DATABASE_SSL=verify-full
DATABASE_CA=
# One long-lived process, so a real pool is fine here — just stay under
# Aiven's plan max_connections (check the Overview tab). On serverless this
# had to be 1, because every warm instance kept its own.
DATABASE_POOL_MAX=10

# --- Auth ---
# Required — sessions are HS256 JWTs and signing fails without it.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Admin dashboard ---
# Master key for admin endpoints. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# --- Order notification email (Gmail SMTP) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=mizohazembargal@gmail.com

# --- Paymob (online payments) ---
# From Paymob Dashboard > Settings > API Keys
PAYMOB_SECRET_KEY=egy_sk_xxx
PAYMOB_PUBLIC_KEY=egy_pk_xxx
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
